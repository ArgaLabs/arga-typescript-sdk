{
  "name": "arga-sdk",
  "version": "0.2.0",
  "type": "module",
  "description": "TypeScript SDK for the Arga API",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./tracing": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "examples:check": "tsc --noEmit -p tsconfig.examples.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package:check": "node scripts/package-smoke.mjs",
    "format": "prettier --write src tests scripts .github \"*.json\" README.md"
  },
  "keywords": [
    "arga",
    "testing",
    "validation",
    "api",
    "sdk"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ArgaLabs/arga-typescript-sdk.git"
  },
  "engines": {
    "node": ">=18.3.0"
  },
  "devDependencies": {
    "@googleapis/gmail": "^18.0.0",
    "@types/node": "^25.5.2",
    "braintrust": "^3.44.0",
    "prettier": "^3.10.1",
    "stripe": "^22.6.2",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.0",
    "vitest": "^3.1.1"
  },
  "dependencies": {
    "ajv": "^8.20.0"
  },
  "bin": {
    "arga-braintrust-sync": "./dist/tracing/cli.js"
  }
}
